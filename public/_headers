# Response headers for Cloudflare Pages (ignored by GitHub Pages).
# No CSP / COEP yet: they can block Turnstile and the contact Worker, so add them
# in report-only mode first.
/*
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY

# Vite fingerprints everything under /assets/, so it's safe to cache forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
